{
  "name": "expense-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "hash-password": "node scripts/hash-password.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:demo": "node --env-file-if-exists=.env --import tsx scripts/db-demo.ts",
    "parse-sms": "node --import tsx scripts/parse-sms.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
